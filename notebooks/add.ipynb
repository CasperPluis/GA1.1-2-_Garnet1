   "source": [
    "def add(a, b):\n",
    "    return a + b\n",
    "\n",
    "print(add(1, 5))\n",
    "print(add(-4, 8))\n",
    "print(add(6, 9))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
